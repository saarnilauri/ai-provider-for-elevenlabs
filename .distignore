# Local credentials. The integration suite reads ELEVENLABS_API_KEY from .env,
# and .wp-env.override.json carries the same key for the local WordPress
# environment, so neither may ever be packaged.
.env
.env.*
/.wp-env.json
/.wp-env.override.json
